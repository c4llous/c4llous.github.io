# Copy to .env.local for local dev; set the same variables in your host (e.g. Vercel → Settings → Environment Variables).
# These are read server-side only (server/contact.ts). Never prefix them with VITE_ — that would ship them to the browser.
TELEGRAM_BOT_TOKEN=123456789:replace-with-a-fresh-token-from-BotFather
TELEGRAM_CHAT_ID=123456789
# Optional: lock the endpoint to your domain(s), comma-separated.
# ALLOWED_ORIGINS=https://riteshsingh.dev,https://www.riteshsingh.dev
